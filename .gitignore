# macOS
.DS_Store
.AppleDouble
.LSOverride

# Xcode user state
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Build products
build/
DerivedData/
*.moved-aside
*.hmap
*.dSYM.zip
*.dSYM

# Test results
*.xcresult

# Swift Package Manager
.swiftpm
.build/

# Generated by xcode-build-server for SourceKit-LSP editor integration.
buildServer.json

# sift's own index cache, for when the tool indexes this repository.
.sift/

# Machine-local agent state — `.claude/settings.local.json` records one machine's granted permissions.
# Listed here rather than left to a global ignore file: a global one does not travel with a clone, so
# on a public repository it is no protection at all.
.claude/

# Logs
*.log

# Benchmark results: raw streams and per-run summaries stay local; only the committed sample is tracked.
Benchmarks/results/*
!Benchmarks/results/sample/

# machine-local pre-commit check, never tracked
githooks/pre-commit.local
__pycache__/
