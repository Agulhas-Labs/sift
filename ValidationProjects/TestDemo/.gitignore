# Generated by xcodegen from project.yml — never committed, and regenerated with `xcodegen generate`.
TestDemo.xcodeproj/

# Build scratch, always inside this worktree, never a fresh temp directory.
.derived/
.gates-logs/

# The trigger directory is committed empty (via .gitkeep); everything gates.sh or a manual run
# drops inside it is machine-local scratch state, not part of the fixture.
.triggers/*
!.triggers/.gitkeep
